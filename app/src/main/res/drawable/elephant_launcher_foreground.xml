<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Use the original rounded-square mascot artwork as a centered inset tile.
         A 72dp inset keeps the full elephant and tile within common adaptive-icon mask safe areas. -->
    <item
        android:drawable="@drawable/elephant_mascot"
        android:width="72dp"
        android:height="72dp"
        android:gravity="center" />
</layer-list>
