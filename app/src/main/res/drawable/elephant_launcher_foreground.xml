<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Use the original rounded-square mascot artwork as a centered inset tile.
         A 64dp centered tile keeps the trunk and feet within the adaptive icon safe circle while retaining visible edge spacing. -->
    <item
        android:drawable="@drawable/elephant_mascot"
        android:width="64dp"
        android:height="64dp"
        android:gravity="center" />
</layer-list>
